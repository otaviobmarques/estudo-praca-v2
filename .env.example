# Local (Docker): postgres://estudo:<SENHA>@127.0.0.1:5433/estudo_praca
# Supabase/Vercel: string do pooler em modo transação (Project Settings → Database → Connection string → Transaction, porta 6543)
#   postgres://postgres.<REF>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://estudo:<SENHA>@127.0.0.1:5433/estudo_praca
POSTGRES_PASSWORD=<SENHA>
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# CHROME_PATH=/usr/bin/google-chrome   (na Vercel deixe vazio: usa @sparticuz/chromium)
# DATABASE_SSL=false                   (força conexão sem SSL)
# EMAIL_SERVICO=  (a definir na implantação)
